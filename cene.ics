ACTION:DISPLAY
TRIGGER:-PT9H30M
DESCRIPTION:Stasera: Pasta con crema di cavolfiore e gamberi (senza lattos
 io)
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT23H
DESCRIPTION:Per domani sera (Pasta con crema di cavolfiore e gamberi (senz
